# Public site URL, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://codebaxh.com

# --- Contact form email -------------------------------------------------
# Enquiries are delivered to baxhcode@gmail.com by default (src/config/site.ts).
# Set this only to send them somewhere else.
CONTACT_TO_EMAIL=

# Option A: Gmail SMTP (simplest for a Gmail inbox)
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an app password at https://myaccount.google.com/apppasswords
#   3. Put the Gmail address in SMTP_USER and the 16-character app password in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=baxhcode@gmail.com
SMTP_PASS=

# Option B: Resend (used instead of SMTP when the key is set).
# Needs a verified sending domain and CONTACT_FROM_EMAIL on that domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# --- Optional: Cloudflare Turnstile spam check ---------------------------
NEXT_PUBLIC_TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional: Cal.com booking embed on /contact (e.g. "codebaxh/discovery")
NEXT_PUBLIC_CAL_LINK=

# --- Optional: Plausible analytics (cookieless). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Optional: search-console ownership tags ------------------------------
# Paste the code from Google Search Console / Bing Webmaster Tools ("HTML tag" method).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
